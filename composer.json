{
  "name": "wesolvers/empirical-responsive-images",
  "description": "Evidence-driven responsive image sizes and local modern-format generation for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "WeSolvers",
      "homepage": "https://wesolvers.com/"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "autoload-dev": {
    "psr-4": {
      "EmpiricalResponsiveImages\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "parallel-lint empirical-responsive-images.php includes uninstall.php languages tests",
    "phpcs": "phpcs --standard=phpcs.xml.dist",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
    "test": "phpunit --configuration=phpunit.xml.dist",
    "review:readiness": "tools/check-review-readiness.sh",
    "check": [
      "@lint:php",
      "@phpcs",
      "@phpstan",
      "@test",
      "@review:readiness"
    ]
  }
}
